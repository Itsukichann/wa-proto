{
  "name": "wa-proto",
  "version": "1.0.0",
  "description": "Protobuf files from WhatsApp WEB",
  "main": "proto/index.js",
  "files": [
    "proto/*"
  ],
  "scripts": {
    "build": "npm run fetch && npm run generate",
    "fetch": "node index.js",
    "generate": "node generate-proto.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Itsukichann/wa-proto.git"
  },
  "author": {
    "name": "Itsukichann",
    "url": "https://github.com/Itsukichann"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Itsukichann/wa-proto/issues"
  },
  "homepage": "https://github.com/Itsukichann/wa-proto#readme",
  "dependencies": {
    "long": "latest",
    "protobufjs": "latest"
  },
  "devDependencies": {
    "acorn": "latest",
    "acorn-walk": "latest",
    "protobufjs-cli": "latest",
    "request": "latest",
    "request-promise-core": "latest",
    "request-promise-native": "latest"
  }
}